# §34 — variables del SERVIDOR. Este archivo NUNCA se lee desde la app: nada de
# aquí lleva el prefijo EXPO_PUBLIC_, y por lo tanto nada de aquí acaba dentro
# del APK. El .env.example de la raíz es el del cliente, y son dos archivos
# separados a propósito.
ANTHROPIC_API_KEY=
MODELO_EMBEDDINGS=paraphrase-multilingual-MiniLM-L12-v2
MODELO_LLM=claude-haiku-4-5-20251001
TIMEOUT_LLM=8

# openssl rand -hex 32 — mismo valor que el secret AI_SHARED_TOKEN de Supabase.
AI_SHARED_TOKEN=
# Solo durante una rotación (§24): el servicio acepta ambos mientras dura la
# ventana, para no tener que apagarlo.
AI_SHARED_TOKEN_SIGUIENTE=
