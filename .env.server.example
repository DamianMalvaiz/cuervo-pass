# Variables del SERVIDOR y de las HERRAMIENTAS. Nada de aqui lleva el prefijo
# EXPO_PUBLIC_, y por lo tanto nada de aqui acaba dentro del APK.
#
# Los scripts lo cargan junto al de cliente:
#   node --env-file=.env --env-file=.env.server scripts/<lo-que-sea>.mjs
#
# No confundir con ai-service/.env, que es del microservicio de Python y lo lee
# su propio config.py. Son tres archivos con tres destinos (ver AGENTS.md).
# Lo leen ocho scripts y dos Edge Functions. Salta TODO el RLS: si esta
# clave se filtra, la separacion entre cuentas deja de existir.
SUPABASE_SERVICE_ROLE_KEY=

# La consume el CLI de Supabase (db push, db dump), no codigo nuestro.
SUPABASE_DB_PASSWORD=

# Destino del microservicio para scripts/backfill-embeddings.mjs, que lo
# llama DIRECTO (sin pasar por ai-proxy) porque solo usa embeddings, que son
# gratis. Se llamaba EXPO_PUBLIC_AI_SERVICE_URL: ese prefijo la compilaba
# dentro del APK para nada, porque la app no la usa desde la v5.
AI_SERVICE_URL=

# Credencial del barrido programado de fotos (migracion 0025). El mismo
# valor tiene que estar en los secrets de Supabase y en Vault.
CRON_SECRET=
