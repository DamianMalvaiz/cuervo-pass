# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (§34) — dos archivos separados: el del cliente en la raíz y
# el del servidor en ai-service/. Nunca se versiona ninguno de los dos.
.env
.env*.local
.env.server
ai-service/.env

# respaldos previos a cada `db push` a partir de la semana 5 (§33.4)
respaldos/

# ai-service (Python)
ai-service/venv/
ai-service/.venv/
ai-service/.pytest_cache/
ai-service/__pycache__/
ai-service/**/__pycache__/
*.pyc

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# herramientas de Claude Code personales/pesadas (binarios compilados, no código del proyecto)
.claude/settings.local.json
.claude/skills/

# archivos temporales del CLI de Supabase
supabase/.temp/

# Worktrees de sesiones de Claude Code — copias del propio repo, nunca se suben.
.claude/worktrees/

# Dominio del túnel en curso: cambia en cada arranque.
.tunel-actual
coverage/

# Imágenes de MUESTRA de la demo (scripts/generar-muestras-demo.py): se regeneran.
demo-material/

# Credenciales del túnel con nombre de Cloudflare: viven en ~/.cloudflared, pero si alguien las copia al repo, que no se versionen.
.cloudflared/
cert.pem

# Salida generada de la web pública (node scripts/construir-web-publica.mjs)
web-publica/dist/

# Salida generada del panel de admin web (node scripts/construir-web-admin.mjs)
web-admin/dist/

# Firebase (push en Android). La clave de la cuenta de servicio (FCM V1) es un SECRETO y se sube a EAS, nunca al repositorio. `google-services.json` va por EAS como variable de tipo
# archivo (GOOGLE_SERVICES_JSON): lleva claves de API que gitleaks marca por su forma. Para compilar en local se puede dejar en la raíz, ignorado.
google-services.json
*-firebase-adminsdk-*.json
*service-account*.json

# Salida generada de la web de la app (node --env-file=.env scripts/construir-app-web.mjs)
app-web/dist/
app-web/.wrangler/
