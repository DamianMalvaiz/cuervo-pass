# §34 — variables del CLIENTE. Todo lo que lleva el prefijo EXPO_PUBLIC_ se
# compila DENTRO del bundle de la app, donde cualquiera con el APK lo lee. Por
# eso aquí solo van valores públicos por diseño, y las claves del servidor viven
# en ai-service/.env y en los secrets de Supabase.
#
# El .env único de v3 —cliente y servidor mezclados— es el defecto más peligroso
# que tenía: tarde o temprano alguien le pone EXPO_PUBLIC_ a la variable
# equivocada y publica la API key de Anthropic en una tienda de aplicaciones.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Token PÚBLICO de Mapbox (pk.), con restricción de URL. Se usa SOLO para el
# autocompletado de calles y el mapa — uso temporal, que sí cubre la capa
# gratuita. Las coordenadas que se GUARDAN vienen de Nominatim/OSM a través de
# la Edge Function `geocodificar` (AUD-02).
EXPO_PUBLIC_MAPBOX_TOKEN=
